{
  "version": 2,
  "services": [
    {
      "name": "oil-spill-backend",
      "type": "web",
      "buildCommand": "bash deploy.sh",
      "startCommand": "gunicorn app:app --workers 1 --threads 4 --timeout 120 --bind 0.0.0.0:$PORT",
      "env": {
        "PORT": "8080",
        "PYTHON_VERSION": "3.10.13",
        "PYTHONUNBUFFERED": "1",
        "SERVER_NAME": "oil-spill-backend"
      },
      "python": {
        "version": "3.10.13",
        "memory": "2048"
      }
    }
  ]
}
